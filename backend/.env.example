# Server
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Database: "file" for local development, "supabase" for production
DATABASE_DRIVER=file
# DATABASE_DRIVER=supabase
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM provider: gemini | mistral | cerebras | openai | demo
# "demo" returns clearly labelled sample text and is refused in production.
LLM_PROVIDER=demo
# LLM_API_KEY=your-provider-key
# LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_MS=15000

# Local file database directory (only used when DATABASE_DRIVER=file)
DATA_DIR=./data

RATE_LIMIT_PER_MINUTE=120
